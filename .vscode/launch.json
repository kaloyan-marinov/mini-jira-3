{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Node : Populate DB",
      "program": "${workspaceFolder}/scripts/issue-requests-based-on-csv-file.js",
      // "program": "${file}",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "args": [
        "${workspaceFolder}/scripts/example-issues.csv"
      ]
    },
    {
      "name": "Node Backend",
      "type": "node",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      },
      "program": "${workspaceFolder}/src/server.js"
    },
    {
      "name": "Nodemon Backend",
      "type": "node",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"]
    }
  ]
}
